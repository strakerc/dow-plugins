#!/bin/sh
#
# dow-plugins commit-msg hook — contact data in the message itself
# ---------------------------------------------------------------------------
# pre-commit rule 6 scans added FILE lines. It never sees the commit message,
# because git does not offer one to pre-commit. A phone number typed into a
# message is exactly as public as one typed into a file, and `git grep` does not
# read messages either -- the historical audit on 6 Sep 2026 had to check them
# separately, which is what surfaced the gap.
#
# Same patterns as rule 6, from the same file, so the two cannot drift.
#
# No new setup: core.hooksPath already points at this directory, so a clone that
# ran the one documented command gets this hook with it.
#     git config core.hooksPath .githooks
# ---------------------------------------------------------------------------

msg_file=$1
[ -n "$msg_file" ] && [ -f "$msg_file" ] || exit 0

contact_lib=".githooks/contact-lib.sh"
if [ ! -f "$contact_lib" ]; then
  printf 'note: %s is missing, so the commit message was NOT checked for contact data.\n' "$contact_lib"
  exit 0
fi
. "$contact_lib" 2>/dev/null

# Sourcing can succeed loudly and still define nothing -- a library that fails to
# parse leaves the matchers undefined, and calling an undefined function returns
# the empty string, which reads exactly like "no contact data found". Checking the
# file exists is not the same as checking the check works.
if ! command -v bad_phone_in >/dev/null 2>&1 || ! command -v bad_email_in >/dev/null 2>&1; then
  printf 'note: %s did not load, so the commit message was NOT checked for contact data.\n' "$contact_lib"
  exit 0
fi

# Comment lines never reach the stored message, so scanning them would be
# checking text that is about to be discarded -- and with commit.verbose the
# whole diff arrives in them, which is pre-commit's job, not this hook's.
# Numbering happens BEFORE the strip so reported lines match the file the author
# is looking at.
body=$(awk '{ if ($0 !~ /^#/) print NR ":" $0 }' "$msg_file")
[ -z "$body" ] && exit 0

# Trailers carry machine identities: the co-author line, and GitHub's per-user
# noreply address on every commit. Neither is member contact data. Exempt them by
# VALUE, like the placeholders -- never by skipping trailer lines wholesale,
# which is precisely where a real address would end up hiding.
bad_email_in_msg() {
  bad_email_in "$1" | grep -viE '^noreply@|@users\.noreply\.github\.com$'
}

# The author and committer identities are stamped into every commit object and
# published with it, and `git grep` cannot see them -- which is why the historical
# audit had to read them separately. WARN, never block: refusing a commit over a
# git identity would be hostile, trivially bypassed, and would fire on every
# commit until the config changed. GitHub's per-user noreply form is the safe
# answer and is what this repo already uses.
for _who in "$(git var GIT_AUTHOR_IDENT 2>/dev/null)" "$(git var GIT_COMMITTER_IDENT 2>/dev/null)"; do
  _addr=$(bad_email_in_msg "$_who")
  if [ -n "$_addr" ]; then
    printf 'note: your git identity is a real-looking address, and every commit publishes it.\n'
    printf '      Consider a noreply address: git config user.email <id>+<user>@users.noreply.github.com\n'
    break
  fi
done

hits=$(printf '%s\n' "$body" | while IFS= read -r entry; do
  n=${entry%%:*}
  t=${entry#*:}
  [ -n "$(bad_phone_in "$t")" ]     && printf '%s a phone number\n' "$n"
  [ -n "$(bad_email_in_msg "$t")" ] && printf '%s an email address\n' "$n"
done)

if [ -n "$hits" ]; then
  red=""; bold=""; off=""
  if [ -t 1 ]; then
    red=$(printf '\033[31m'); bold=$(printf '\033[1m'); off=$(printf '\033[0m')
  fi
  # The value is not echoed, for the same reason rule 6 withholds it: this repo
  # is public and the message is about to become part of it permanently.
  printf '%s%sBLOCKED%s the commit message contains contact data — this repo is PUBLIC.\n' \
    "$red" "$bold" "$off"
  printf '%s\n' "$hits" | sed 's/^/          line /'
  printf '          A message cannot be edited after pushing without rewriting history.\n'
  printf '          Describe the shape instead, or use a 555-01XX number or example.com.\n'
  printf '\n%sCommit refused.%s Fix the message, or `git commit --no-verify` if you are certain.\n' \
    "$bold" "$off"
  exit 1
fi

exit 0
