#!/bin/sh
#
# dow-plugins pre-commit hook
# ---------------------------------------------------------------------------
# This repository is PUBLIC and its contents load as instructions inside other
# people's Claude accounts. Two classes of mistake are expensive enough to be
# worth blocking before they leave the machine:
#
#   1. Committing a credential. Public repo; a leaked key is leaked to everyone.
#   2. Reintroducing `$` followed by a single digit in a SKILL.md. That gets
#      silently replaced at load time with a word from the invocation arguments
#      -- `+$5` became `+due` -- which rewrote entire price tables into prose
#      without any error. Amounts under ten are written WITHOUT the sign on
#      purpose. See the repo README and the editing notes in each skill.
#
# Install once per clone:
#     git config core.hooksPath .githooks
#
# Bypass for a single commit (you had better have a reason):
#     git commit --no-verify
#
# Written 5 Sep 2026. Uses only POSIX sh and grep, both of which ship with Git
# for Windows, so it runs the same on Windows, macOS and Linux.
# ---------------------------------------------------------------------------

fail=0
red=""
bold=""
off=""
if [ -t 1 ]; then
  red=$(printf '\033[31m'); bold=$(printf '\033[1m'); off=$(printf '\033[0m')
fi

say_fail() {
  printf '%s%sBLOCKED%s %s\n' "$red" "$bold" "$off" "$1"
  fail=1
}

# Staged files, added/copied/modified/renamed only (not deletions).
staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

# Paths can contain spaces, and every loop below iterates $staged unquoted. Split
# on newlines only, or "my skill/SKILL.md" becomes two paths and the real file
# gets no dollar-digit scan at all -- a silent bypass of the rule this hook
# exists for. NOTE: with IFS set this way, any space-separated literal list must
# become a newline-separated variable (see json_candidates below).
IFS='
'

# ---------------------------------------------------------------------------
# 1. Filenames that must never be committed
# ---------------------------------------------------------------------------
# .mcp.json is the important one: a plugin CAN declare its own MCP connector,
# and that connector URL carries a personal key. In a public repo that is a
# published credential.
for f in $staged; do
  case "$f" in
    .mcp.json|*/.mcp.json)
      say_fail "$f — a plugin must never declare its own connector. The URL carries a key and this repo is public."
      ;;
    .env|.env.*|*/.env|*/.env.*)
      say_fail "$f — environment files hold secrets; keep them out of the repo."
      ;;
    *.pem|*.p12|*.pfx|id_rsa|*/id_rsa|*.key)
      say_fail "$f — looks like a key or certificate file."
      ;;
    wrangler.toml|*/wrangler.toml)
      say_fail "$f — worker config carries bindings and sometimes vars; it belongs with the worker source, not here."
      ;;
  esac
done

# ---------------------------------------------------------------------------
# 2. Credentials in the added lines
# ---------------------------------------------------------------------------
# Scan only ADDED lines. Scanning whole files would re-flag anything already
# present and train everyone to use --no-verify, which is worse than no hook.
added=$(git diff --cached -U0 --diff-filter=ACMR | grep '^+' | grep -v '^+++')

scan() { # pattern, human description
  # -e matters: several patterns begin with "-" and would be read as options.
  if printf '%s' "$added" | grep -Eq -e "$1"; then
    say_fail "an added line contains what looks like $2."
  fi
}

scan 'lk_[A-Za-z0-9]{16,}'                'a league key (lk_…)'
scan 'gh[pousr]_[A-Za-z0-9]{20,}'         'a GitHub token (ghp_/gho_/ghu_/ghs_/ghr_…)'
scan 'github_pat_[A-Za-z0-9_]{20,}'       'a GitHub fine-grained token'
scan '-----BEGIN [A-Z ]*PRIVATE KEY-----' 'a private key block'
scan '"private_key"[[:space:]]*:'         'a Google service-account private_key field'
scan 'sk-[A-Za-z0-9]{20,}'                'an sk- style API key'
scan 'xox[baprs]-[A-Za-z0-9-]{10,}'       'a Slack token'
scan 'APIKEY=[A-Za-z0-9]{8,}'             'an APIKEY= parameter with a value'

# ---------------------------------------------------------------------------
# 3. The dollar-sign rule, in SKILL.md files only
# ---------------------------------------------------------------------------
# `$` + ONE digit is destroyed at load time. Two or more digits are safe, which
# is why $25 and $375 are fine and $5 is not.
for f in $staged; do
  case "$f" in
    *SKILL.md)
      hits=$(git show ":$f" 2>/dev/null | grep -nE '\$[0-9]([^0-9]|$)')
      if [ -n "$hits" ]; then
        say_fail "$f contains \$ followed by a single digit — that gets silently replaced at load time."
        # Redact contact-shaped text before echoing the line. Rule 6 withholds
        # such values on purpose, and printing the whole line here would put a
        # phone number into scrollback and CI logs anyway whenever one line
        # carries both faults.
        printf '%s\n' "$hits" \
          | sed -E 's/[0-9]{3}[-. )]*[0-9]{3}[-. ][0-9]{4}/[redacted]/g; s/[0-9]{10}/[redacted]/g; s/[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}/[redacted]/g' \
          | sed 's/^/          /'
        printf '          Write amounts under ten without the sign (+5), or put the unit in the table header.\n'
      fi
      ;;
  esac
done

# ---------------------------------------------------------------------------
# 4. JSON must parse
# ---------------------------------------------------------------------------
# A broken marketplace.json or plugin.json breaks the install for everyone, and
# the failure surfaces in someone else's Claude, not here. Skipped silently if
# no interpreter is available -- a hook that errors on a clean machine gets
# disabled.
#
# `command -v` is NOT enough to choose one. On Windows the Microsoft Store ships
# python3 and python as App Execution Alias stubs: they sit on PATH, so
# `command -v` finds them, but running one prints an install message and exits
# 49. Trusting that made this check call every valid .json invalid -- and the
# only way past a false BLOCKED is --no-verify, which switches off the
# credential and dollar-digit checks at the same time. Probe with known-good
# JSON and accept only an interpreter that actually parses it.
json_run() { # $1 = interpreter; reads stdin, exits 0 iff it parsed as JSON
  case "$1" in
    node) "$1" -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{JSON.parse(s)})' ;;
    *)    "$1" -c 'import json,sys; json.load(sys.stdin)' ;;
  esac
}

# Newline-separated because IFS is a newline; a space-separated list would be
# read as one word.
json_candidates='python3
python
node'

# Only probe if a .json is actually being committed. Probing costs up to two
# process spawns per candidate, and most commits here touch only SKILL.md.
staged_json=""
for f in $staged; do
  case "$f" in *.json) staged_json=yes; break ;; esac
done

json_check=""
[ -n "$staged_json" ] && for cand in $json_candidates; do
  command -v "$cand" >/dev/null 2>&1 || continue
  # Two-sided on purpose: a candidate must accept valid JSON AND reject invalid
  # JSON. Testing only acceptance would select an interpreter that exits 0 for
  # every input -- a PATH wrapper, or a future stub that exits 0 rather than 49
  # -- and this section would quietly become a no-op that still looks active.
  # That is worse than the false BLOCKED this probe was added to prevent,
  # because it is silent: a broken marketplace.json would commit clean and
  # break the install for everyone.
  printf '{"probe":1}' | json_run "$cand" >/dev/null 2>&1 || continue
  printf '{"probe":'   | json_run "$cand" >/dev/null 2>&1 && continue
  json_check="$cand"
  break
done

if [ -n "$json_check" ]; then
  for f in $staged; do
    case "$f" in
      *.json)
        git show ":$f" | json_run "$json_check" >/dev/null 2>&1 \
          || say_fail "$f is not valid JSON."
        ;;
    esac
  done
else
  # Skipping is deliberate, but skipping SILENTLY while .json is being committed
  # is how invariant 3 goes missing without anyone noticing. Say so; never fail
  # on it, or a machine with no interpreter cannot commit at all.
  for f in $staged; do
    case "$f" in
      *.json)
        printf 'note: no working JSON interpreter on PATH — %s was NOT checked.\n' "$f"
        ;;
    esac
  done
fi

# ---------------------------------------------------------------------------
# 5. Every SKILL.md carries the connector footer, verbatim
# ---------------------------------------------------------------------------
# CLAUDE.md says every skill ends with the "If the league tools aren't there"
# footer. For a while league-rules did not, and nothing noticed: the rule lived
# in prose with no check behind it. That footer is what forbids answering from
# memory when the connector is missing, so a skill without it fails in the worst
# way available -- confidently, with invented league facts, inside someone
# else's account.
#
# The canonical text is .githooks/skill-footer.md. Copy it into a new skill
# rather than retyping it. Sections AFTER it are fine -- league-schedule adds
# one about identifiers -- so only the opening lines have to match. Paraphrase
# does not count: the wording carries the connector setup steps people follow.
footer_ref=".githooks/skill-footer.md"

# Read the reference from the INDEX, the same way the skills below are read.
# Comparing staged content against the working-tree copy makes the verdict depend
# on edits nobody is committing: a half-finished reword of the footer blocks
# unrelated skill commits, and a reference edited to match a bad footer would wave
# that footer through. Fall back to disk only when the reference is untracked.
ref_text=$(git show ":$footer_ref" 2>/dev/null)
if [ -z "$ref_text" ] && [ -f "$footer_ref" ]; then
  ref_text=$(cat "$footer_ref")
fi

if [ -n "$ref_text" ]; then
  # awk counts a final unterminated line as a record; `wc -l` counts newlines and
  # would return one fewer for a reference saved without a trailing newline, so
  # the comparison would quietly skip its last line -- the one banning answers
  # from memory. Silent weakening is exactly what this rule exists to stop.
  ref_lines=$(printf '%s\n' "$ref_text" | awk 'END{print NR}')
  for f in $staged; do
    case "$f" in
      *SKILL.md)
        got=$(git show ":$f" 2>/dev/null \
              | awk '/^## If the league tools aren.t there/{p=1} p' \
              | head -n "$ref_lines")
        if [ -z "$got" ]; then
          say_fail "$f has no \"If the league tools aren't there\" footer — append $footer_ref verbatim."
        elif [ "$got" != "$ref_text" ]; then
          say_fail "$f's connector footer is not verbatim; it must match $footer_ref."
          if command -v diff >/dev/null 2>&1; then
            printf '%s\n' "$got" | diff "$footer_ref" - | head -8 | sed 's/^/          /'
          fi
        fi
        ;;
    esac
  done
else
  # Only reachable if the reference is gone from both index and disk. Say so
  # rather than failing: a hook that blocks every commit gets bypassed, and that
  # takes the other four rules with it.
  for f in $staged; do
    case "$f" in
      *SKILL.md) printf 'note: %s is missing, so SKILL.md footers were NOT checked.\n' "$footer_ref"; break ;;
    esac
  done
fi
# ---------------------------------------------------------------------------
# 6. Contact data — phone numbers and email addresses
# ---------------------------------------------------------------------------
# get_league returns every owner's phone and email, and league-contacts reads
# them at run time. None of it belongs in the repo. This is the one category
# where a mistake cannot be taken back: the remote is public, so a number is
# published the moment it lands, and `git revert` does not unpublish it.
#
# ADDED LINES ONLY, like rules 1 and 2. A rule that re-flags existing content
# trains everyone to reach for --no-verify, which switches off the credential
# checks at the same time.
#
# The offending value is deliberately NOT printed. The author can see their own
# line; echoing a real number into terminal scrollback or a CI log spreads it
# further, which is the opposite of the point.
#
# Placeholders are exempt by VALUE, never by file. Exempting a file is exactly
# where a real number would eventually be written:
#   phones  — the reserved fictional range, any area code + 555 + 01XX
#   emails  — example.com, example.org, example.net
#
# The ten-digit match is bounded by non-digits on both sides, so a longer digit
# run is not a phone number: the Discord channel id in fa-auction-grades is 18
# digits and must not trip this.
# Boundaries must NOT be consumed. With the ERE form `(^|[^0-9])...([^0-9]|$)`,
# grep -o eats the separator between two adjacent numbers, so in
# "<placeholder> <real number>" the placeholder matches, is exempted, and the
# real number beside it is never seen -- a silent miss on exactly the sentence a
# doc writes ("use this, not that"). PCRE lookarounds do not consume, so prefer
# grep -P and fall back to the ERE only where PCRE is unavailable. Probe rather
# than assume: a `grep -P` that is present but unusable would take the check with
# it, the same way the Store python stub once did to the JSON rule.
# The probe string is deliberately not phone-shaped: an earlier draft used real
# example numbers here and rule 6 blocked its own source file, twice.
if echo 'x12 34' | grep -qoP '(?<![0-9])12' 2>/dev/null; then
  PHONE_GREP="-oP"
  PHONE_RE='(?<![0-9])\(?\d{3}\)?[-. ]?\d{3}[-. ]?\d{4}(?![0-9])'
  PHONE_FILTER="-P"
else
  PHONE_GREP="-oE"
  PHONE_RE='(^|[^0-9])\(?[0-9]{3}\)?[-. ]?[0-9]{3}[-. ]?[0-9]{4}([^0-9]|$)'
  PHONE_FILTER="-E"
fi
EMAIL_RE='[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}'

bad_phone_in() { # echoes the digits of any non-exempt number on the line
  # One match at a time, re-supplying a non-digit boundary each round. With the
  # ERE fallback a match consumes the character separating it from the next
  # number, so a single -o pass finds only the first of two adjacent numbers --
  # and if that first one is an exempt placeholder, the real number beside it is
  # never examined. Prefixing "x" after each strip restores the boundary. The
  # loop is harmless under PCRE, where nothing is consumed, so both dialects run
  # the same code rather than only one of them being exercised.
  _rest=$1
  while :; do
    _m=$(printf '%s' "$_rest" | grep $PHONE_GREP "$PHONE_RE" | head -1)
    [ -z "$_m" ] && break
    printf '%s' "$_m" | sed 's/[^0-9]//g' \
      | grep -E '^[0-9]{10}$' | grep -vE '^[0-9]{3}55501[0-9]{2}$'
    _next=${_rest#*"$_m"}
    [ "$_next" = "$_rest" ] && break   # no progress; refuse to spin
    _rest="x$_next"
  done
}

bad_email_in() {
  printf '%s' "$1" | grep -oE "$EMAIL_RE" \
    | grep -viE '@example\.(com|org|net)$'
}

# Added lines of one file, each as "<new-file line number>:<text>".
added_lines_of() {
  git diff --cached -U0 --diff-filter=ACMR -- "$1" | awk '
    /^\+\+\+/ { next }
    /^@@/     { split($3, a, ","); ln = substr(a[1], 2) + 0; next }
    /^\+/     { print ln ":" substr($0, 2); ln++ }
  '
}

for f in $staged; do
  al=$(added_lines_of "$f")
  [ -z "$al" ] && continue
  # Pre-filter so the per-line loop runs only where something might match. It
  # reuses the real patterns on purpose: a hand-written cheaper one was stricter
  # than PHONE_RE -- it had no ")" in its separator class -- and silently skipped
  # every parenthesised-area-code number before the real check ever saw it.
  # $PHONE_FILTER matches the dialect PHONE_RE was written in: -P when the probe
  # above chose lookarounds, -E otherwise. Hardcoding -E here would feed a PCRE
  # to an ERE engine and the pre-filter would stop matching phone numbers at all.
  cand=$(printf '%s\n' "$al" | grep $PHONE_FILTER "$PHONE_RE|$EMAIL_RE")
  [ -z "$cand" ] && continue
  hits=$(printf '%s\n' "$cand" | while IFS= read -r entry; do
    n=${entry%%:*}
    t=${entry#*:}
    [ -n "$(bad_phone_in "$t")" ] && printf '%s a phone number\n' "$n"
    [ -n "$(bad_email_in "$t")" ] && printf '%s an email address\n' "$n"
  done)
  if [ -n "$hits" ]; then
    say_fail "$f adds contact data — this repo is PUBLIC, and pushing it publishes it."
    printf '%s\n' "$hits" | sed 's/^/          line /'
    printf '          The value is not echoed here on purpose. Contact details live in MFL\n'
    printf '          and league-contacts reads them at run time; the repo stores none.\n'
    printf '          Examples must use 555-01XX numbers or example.com addresses.\n'
  fi
done


# ---------------------------------------------------------------------------
if [ "$fail" -ne 0 ]; then
  printf '\n%sCommit refused.%s Fix the above, or `git commit --no-verify` if you are certain.\n' "$bold" "$off"
  exit 1
fi

exit 0
