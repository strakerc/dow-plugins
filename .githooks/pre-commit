#!/bin/sh
#
# dow-plugins pre-commit hook
# ---------------------------------------------------------------------------
# This repository is PUBLIC and its contents load as instructions inside other
# people's Claude accounts. Two classes of mistake are expensive enough to be
# worth blocking before they leave the machine:
#
#   1. Committing a credential. Public repo; a leaked key is leaked to everyone.
#   2. Reintroducing `$` followed by a single digit in a SKILL.md. That gets
#      silently replaced at load time with a word from the invocation arguments
#      -- `+$5` became `+due` -- which rewrote entire price tables into prose
#      without any error. Amounts under ten are written WITHOUT the sign on
#      purpose. See plugins/*/README.md and the editing notes in each skill.
#
# Install once per clone:
#     git config core.hooksPath .githooks
#
# Bypass for a single commit (you had better have a reason):
#     git commit --no-verify
#
# Written 5 Sep 2026. Uses only POSIX sh and grep, both of which ship with Git
# for Windows, so it runs the same on Windows, macOS and Linux.
# ---------------------------------------------------------------------------

fail=0
red=""
bold=""
off=""
if [ -t 1 ]; then
  red=$(printf '\033[31m'); bold=$(printf '\033[1m'); off=$(printf '\033[0m')
fi

say_fail() {
  printf '%s%sBLOCKED%s %s\n' "$red" "$bold" "$off" "$1"
  fail=1
}

# Staged files, added/copied/modified/renamed only (not deletions).
staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

# ---------------------------------------------------------------------------
# 1. Filenames that must never be committed
# ---------------------------------------------------------------------------
# .mcp.json is the important one: a plugin CAN declare its own MCP connector,
# and that connector URL carries a personal key. In a public repo that is a
# published credential.
for f in $staged; do
  case "$f" in
    .mcp.json|*/.mcp.json)
      say_fail "$f — a plugin must never declare its own connector. The URL carries a key and this repo is public."
      ;;
    .env|.env.*|*/.env|*/.env.*)
      say_fail "$f — environment files hold secrets; keep them out of the repo."
      ;;
    *.pem|*.p12|*.pfx|id_rsa|*/id_rsa|*.key)
      say_fail "$f — looks like a key or certificate file."
      ;;
    wrangler.toml|*/wrangler.toml)
      say_fail "$f — worker config carries bindings and sometimes vars; it belongs with the worker source, not here."
      ;;
  esac
done

# ---------------------------------------------------------------------------
# 2. Credentials in the added lines
# ---------------------------------------------------------------------------
# Scan only ADDED lines. Scanning whole files would re-flag anything already
# present and train everyone to use --no-verify, which is worse than no hook.
added=$(git diff --cached -U0 --diff-filter=ACMR | grep '^+' | grep -v '^+++')

scan() { # pattern, human description
  # -e matters: several patterns begin with "-" and would be read as options.
  if printf '%s' "$added" | grep -Eq -e "$1"; then
    say_fail "an added line contains what looks like $2."
  fi
}

scan 'lk_[A-Za-z0-9]{16,}'                'a league key (lk_…)'
scan 'gh[pousr]_[A-Za-z0-9]{20,}'         'a GitHub token (ghp_/gho_/ghu_/ghs_/ghr_…)'
scan 'github_pat_[A-Za-z0-9_]{20,}'       'a GitHub fine-grained token'
scan '-----BEGIN [A-Z ]*PRIVATE KEY-----' 'a private key block'
scan '"private_key"[[:space:]]*:'         'a Google service-account private_key field'
scan 'sk-[A-Za-z0-9]{20,}'                'an sk- style API key'
scan 'xox[baprs]-[A-Za-z0-9-]{10,}'       'a Slack token'
scan 'APIKEY=[A-Za-z0-9]{8,}'             'an APIKEY= parameter with a value'

# ---------------------------------------------------------------------------
# 3. The dollar-sign rule, in SKILL.md files only
# ---------------------------------------------------------------------------
# `$` + ONE digit is destroyed at load time. Two or more digits are safe, which
# is why $25 and $375 are fine and $5 is not.
for f in $staged; do
  case "$f" in
    *SKILL.md)
      hits=$(git show ":$f" 2>/dev/null | grep -nE '\$[0-9]([^0-9]|$)')
      if [ -n "$hits" ]; then
        say_fail "$f contains \$ followed by a single digit — that gets silently replaced at load time."
        printf '%s\n' "$hits" | sed 's/^/          /'
        printf '          Write amounts under ten without the sign (+5), or put the unit in the table header.\n'
      fi
      ;;
  esac
done

# ---------------------------------------------------------------------------
# 4. JSON must parse
# ---------------------------------------------------------------------------
# A broken marketplace.json or plugin.json breaks the install for everyone, and
# the failure surfaces in someone else's Claude, not here. Skipped silently if
# no interpreter is available -- a hook that errors on a clean machine gets
# disabled.
json_check=""
if command -v python3 >/dev/null 2>&1; then json_check="python3"
elif command -v python  >/dev/null 2>&1; then json_check="python"
elif command -v node    >/dev/null 2>&1; then json_check="node"
fi

if [ -n "$json_check" ]; then
  for f in $staged; do
    case "$f" in
      *.json)
        if [ "$json_check" = "node" ]; then
          git show ":$f" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{JSON.parse(s)})' 2>/dev/null \
            || say_fail "$f is not valid JSON."
        else
          git show ":$f" | "$json_check" -c 'import json,sys; json.load(sys.stdin)' 2>/dev/null \
            || say_fail "$f is not valid JSON."
        fi
        ;;
    esac
  done
fi

# ---------------------------------------------------------------------------
if [ "$fail" -ne 0 ]; then
  printf '\n%sCommit refused.%s Fix the above, or `git commit --no-verify` if you are certain.\n' "$bold" "$off"
  exit 1
fi

exit 0
