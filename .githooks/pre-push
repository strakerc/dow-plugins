#!/bin/sh
#
# dow-plugins pre-push hook -- the regression gate, invariant 7
# ---------------------------------------------------------------------------
# Pushing to main IS the deployment here: the marketplace delivers any changed
# file under plugins/ to every installed owner on their next sync. So a push is
# where a regression has to be stopped, and this hook refuses one when the gate
# in validation/regress.py fails -- or cannot run. A suite that could not run is
# not a suite that passed; "the CLI is not logged in" blocks the push too.
#
# What runs, per distinct commit being pushed: the free stages always
# (invariants, script tests, back-test, eval lint), and the skill evals only
# when plugins/ differs from what the remote already has -- and of those, only
# the cases the runner's ledger (.git/dow-evals-ledger.json) does not already
# hold a pass for against the current files. A push straight after a green
# `regress.py --evals` therefore pays nothing.
#
# Installed by the same command as the other hooks:
#     git config core.hooksPath .githooks
#
# Bypass for one push, if you are certain and will say so:
#     git push --no-verify
#
# Written 9 Sep 2026 PT. POSIX sh; the work is in Python.
# ---------------------------------------------------------------------------

zero=0000000000000000000000000000000000000000
red=""; bold=""; off=""
if [ -t 1 ]; then
  red=$(printf '\033[31m'); bold=$(printf '\033[1m'); off=$(printf '\033[0m')
fi

# Pick an interpreter that actually runs -- the Microsoft Store ships python3
# and python as stubs that sit on PATH and exit 49. Same probe as pre-commit.
py=""
for cand in python3 python; do
  command -v "$cand" >/dev/null 2>&1 || continue
  "$cand" -c 'import sys; sys.exit(0)' >/dev/null 2>&1 || continue
  py="$cand"; break
done
if [ -z "$py" ]; then
  printf '%s%sBLOCKED%s no working python3 or python on PATH, so the regression gate cannot run.\n' "$red" "$bold" "$off"
  printf '          The gate is a requirement for every push. Install Python, or `git push --no-verify` if you are certain.\n'
  exit 1
fi

# stdin: "<local ref> <local sha> <remote ref> <remote sha>", one line PER REF.
# `git push origin main v0.3.0` or `git push --all` sends several. Every distinct
# commit gets its own gate run; an earlier version kept only the last line and
# tested nothing else (found in review, 9 Sep 2026 PT). Tag refs are peeled to
# the commit they point at, and a commit pushed under two refs runs once.
seen=""; rc=0
while read -r lref lsha rref rsha; do
  [ "$lsha" = "$zero" ] && continue          # deleting a remote branch: nothing to test
  commit=$(git rev-parse -q --verify "${lsha}^{commit}" 2>/dev/null) || continue
  case " $seen " in *" $commit "*) continue ;; esac
  seen="$seen $commit"
  if [ "$rsha" = "$zero" ]; then
    # New remote ref: compare against origin/main if we have it, else test everything.
    base=$(git rev-parse -q --verify "origin/main^{commit}" 2>/dev/null || printf '')
  else
    base=$(git rev-parse -q --verify "${rsha}^{commit}" 2>/dev/null || printf '%s' "$rsha")
  fi
  printf '\n== gate for %s (%s)\n' "$lref" "$commit"
  "$py" validation/regress.py --pre-push "$commit" "$base"
  rc=$?
  [ "$rc" -ne 0 ] && break
done
[ -z "$seen" ] && exit 0

if [ "$rc" -ne 0 ]; then
  printf '\n%s%sPush refused.%s The regression gate did not pass (exit %s).\n' "$red" "$bold" "$off" "$rc"
  case "$rc" in
    2) printf '          The skill evals could not run. Log the CLI in from a real terminal:  claude auth login\n' ;;
  esac
  printf '          Fix it, or `git push --no-verify` if you are certain -- and say so in the commit or the chat.\n'
  exit 1
fi
exit 0
